<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_ROLEX-65-NCG-DG">
    <Print>
      <Format>Jospo_ROLEX-65-NCG-DG.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="ROLEX-65-NCG-DG_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/ROLEX-65-NCG-DG_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Jospo Rolex 65 NCG DG</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Jospo Rolex 65 NCG DG|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
