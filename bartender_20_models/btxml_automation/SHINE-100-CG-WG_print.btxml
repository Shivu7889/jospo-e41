<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_SHINE-100-CG-WG">
    <Print>
      <Format>Jospo_SHINE-100-CG-WG.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="SHINE-100-CG-WG_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/SHINE-100-CG-WG_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Jospo Shine 100 CG WG</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Jospo Shine 100 CG WG|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
