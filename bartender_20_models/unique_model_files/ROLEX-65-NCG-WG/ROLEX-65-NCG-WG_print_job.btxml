<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_ROLEX-65-NCG-WG">
    <Print>
      <Format>ROLEX-65-NCG-WG.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="ROLEX-65-NCG-WG_Records" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="ROLEX-65-NCG-WG_database.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Jopso Rolex 65 NCG WG</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Jopso Rolex 65 NCG WG|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
