<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_Rolex_35_CG_WG">
    <Print>
      <Format>Jospo_Rolex_35_CG_WG.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="Rolex_35_CG_WG_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/Rolex_35_CG_WG_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Rolex 35 CG WG</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Rolex 35 CG WG|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
