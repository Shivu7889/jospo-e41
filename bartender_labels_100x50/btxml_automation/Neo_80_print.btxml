<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_Neo_80">
    <Print>
      <Format>Jospo_Neo_80.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="Neo_80_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/Neo_80_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Neo 80</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Neo 80|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
