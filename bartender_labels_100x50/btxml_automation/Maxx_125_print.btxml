<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_Maxx_125">
    <Print>
      <Format>Jospo_Maxx_125.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="Maxx_125_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/Maxx_125_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Maxx 125</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Maxx 125|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
