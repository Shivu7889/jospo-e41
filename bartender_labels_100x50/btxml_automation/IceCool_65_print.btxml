<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_IceCool_65">
    <Print>
      <Format>Jospo_IceCool_65.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="IceCool_65_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/IceCool_65_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>IceCool 65</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|IceCool 65|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
