<?xml version="1.0" encoding="utf-8"?>
<XMLScript Version="2.0">
  <Command Name="Print_Tent_Gold">
    <Print>
      <Format>Jospo_Tent_Gold.btw</Format>
      <PrintSetup>
        <Printer>TSC TE244</Printer>
        <NumberSerializedLabels>100</NumberSerializedLabels>
      </PrintSetup>
      <RecordSet Name="Tent_Gold_Data" Type="btTextFile">
        <Delimited Delimiter=",">
          <TextDataFile File="individual_models/Tent_Gold_100_labels.csv" />
        </Delimited>
      </RecordSet>
      <NamedSubString Name="MODEL_NAME">
        <Value>Tent Gold</Value>
      </NamedSubString>
      <NamedSubString Name="SERIAL_NO">
        <Value>#000001</Value>
      </NamedSubString>
      <NamedSubString Name="QR_PAYLOAD">
        <Value>JSP|Tent Gold|000001</Value>
      </NamedSubString>
    </Print>
  </Command>
</XMLScript>
